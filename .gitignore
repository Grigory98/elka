# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Editors and IDEs
.idea/
.vscode/
*.swp

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Secrets and local env files
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Build output
bin/
.task/
dist/
out/
frontend/dist/
build/linux/appimage/build/
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
webview2/

# Objects and binaries produced during builds
*.o
*.syso
*.dll
*.so
*.dylib
__debug_bin.exe

# Local vault, settings and logs
*.db
*.db-shm
*.db-wal
/settings.json
*.log

# Release artifacts
releases/
*.dmg
*.pkg

# Caches
.eslintcache
*.tsbuildinfo
coverage/
frontend/.vite/

# Local debugging
# Working notes from an investigation session: useful while it lasts, noise afterwards.
MEMORY_WORKLOG.md
# Heap snapshots and memory dumps taken from the webview.
*.heapsnapshot
*.heapprofile
# Scratch copy of the measurement harness, which lives outside the repository.
memory-harness/
