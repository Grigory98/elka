<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="elka.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Elka\Elka">
    </Installer>
    <PackageInformation
        PackageName="Elka"
        PackageDisplayName="Elka"
        PublisherName="CN=Elka"
        PublisherDisplayName="Elka"
        Version="0.1.0.0"
        PackageDescription="Elka SSH client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.elka.desktop"
                Description="Elka SSH client"
                DisplayName="Elka"
                ExecutableName="elka.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Elka</DisplayName>
            <PublisherDisplayName>Elka</PublisherDisplayName>
            <Description>Elka SSH client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="elka.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
